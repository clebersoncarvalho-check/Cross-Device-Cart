{% comment %}
  Cross Device Cart — cole no <head> do layout/theme.liquid (cedo).
  O GET do app começa aqui; o JS só consome o resultado.
{% endcomment %}
{% if customer %}
  <style>
    .madesa-header-desktop.section.shopify-section {
      background: darkgreen !important;
    }
  </style>
  <script>
    window.__cartSyncEnabled = true;
    window.__cartSyncCustomerId = {{ customer.id | json }};
    window.__cartSyncPrefetch = fetch('/apps/cart-sync', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    }).then(function (r) {
      return r.json();
    });
  </script>
{% else %}
  <script>
    window.__cartSyncEnabled = false;
    window.__cartSyncCustomerId = null;
  </script>
{% endif %}

<script src="{{ 'cart-sync.js' | asset_url }}" defer></script>
